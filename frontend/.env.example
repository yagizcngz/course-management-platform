# Copy to .env.development.local for local development.
# Seed:DemoPassword from backend/EdTechApi.API/appsettings.Development.json; shows the demo account pills on /login (dev builds only).
VITE_DEMO_PASSWORD=
# API origin baked into the build; required for any non-local build (e.g. https://api.ekurs.example).
VITE_API_BASE=
